<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.charlesmcp</groupId>
        <artifactId>charles-mcp-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>charles-mcp-agent</artifactId>
    <name>charles-mcp-agent</name>
    <description>
        In-process Java agent for Charles 4.6.x. Registers a read-only proxy lifecycle listener and serves
        captured transaction metadata over an authenticated loopback socket. No runtime dependencies, so it
        cannot conflict with anything on Charles's classpath.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>charles-mcp-agent</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>io.github.charlesmcp.agent.JavaAgentEntry</Premain-Class>
                            <Agent-Class>io.github.charlesmcp.agent.JavaAgentEntry</Agent-Class>
                            <Main-Class>io.github.charlesmcp.agent.Launcher</Main-Class>
                            <Implementation-Title>charles-mcp-agent</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
